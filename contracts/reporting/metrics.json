{
  "schema_version": 1,
  "registry_revision": "2026-11-19-P10-measurement-v1",
  "status": "definitions_only_no_site_data",
  "scope": "Cairns ICU liaison evaluation and ANZICS-compatible descriptive comparators",
  "denominators": [
    {
      "id": "D01",
      "label": "All ICU admission episodes",
      "time_anchor": "icu_admission",
      "grain": "hospital ICU episode",
      "inclusion": "all ICU episodes, including repeat admissions",
      "missingness": "missing episode identifiers reported as unknown"
    },
    {
      "id": "D02",
      "label": "All live ICU-to-ward/home discharges",
      "time_anchor": "physical_icu_departure",
      "grain": "live ward/home transfer episode",
      "inclusion": "all live ward/home discharges irrespective of hospital index status",
      "missingness": "unknown destination and missing discharge time excluded and counted"
    },
    {
      "id": "D03",
      "label": "First eligible adult ICU-to-ward discharge per hospitalisation",
      "time_anchor": "physical_icu_departure",
      "grain": "one first eligible index per hospitalisation",
      "inclusion": "eligible adult ward destination with approved age rule and episode linkage",
      "missingness": "unlinked episodes kept unknown, not additional index events"
    },
    {
      "id": "D04",
      "label": "Live ICU-to-ward/home discharges with valid readiness and departure",
      "time_anchor": "clinical_ready_time",
      "grain": "ready-to-departure valid paired timestamp",
      "inclusion": "subset of D02 with both readiness and departure known",
      "missingness": "unknown readiness not zero delay; separate missingness"
    },
    {
      "id": "D05",
      "label": "Index ICU-to-ward discharges with adequate 72-hour ascertainment",
      "time_anchor": "physical_icu_departure",
      "grain": "one index discharge with known at-risk time",
      "inclusion": "D03 eligible with verified 72-hour follow-up or observed earlier event, death or transfer adjudicated",
      "missingness": "death and transfer competing; incomplete follow-up not classified no-return"
    },
    {
      "id": "D06",
      "label": "Actual ICU staffed capacity intervals",
      "time_anchor": "staffed_shift_interval",
      "grain": "time-integrated staffed beds",
      "inclusion": "staffed, available and occupied beds with matching boundaries",
      "missingness": "unreported shift coverage is unknown, not zero beds"
    },
    {
      "id": "D07",
      "label": "All ICU admission demand requests",
      "time_anchor": "admission_request",
      "grain": "one ICU request, admitted/refused/censored",
      "inclusion": "requests including those declined or diverted",
      "missingness": "rejected/unobserved demand cannot be inferred from admissions"
    },
    {
      "id": "D08",
      "label": "Defined annual programme",
      "time_anchor": "programme_fiscal_year",
      "grain": "one intervention comparator/year",
      "inclusion": "paired strategy for annual eligible volume, declared price year",
      "missingness": "missing local annual volume remains unqualified"
    },
    {
      "id": "D09",
      "label": "Aligned paired Monte Carlo iterations",
      "time_anchor": "simulation_draw_id",
      "grain": "same draw ID for both strategies",
      "inclusion": "declared synthetic P4 iterations with matching seeds",
      "missingness": "missing/duplicate draw rejects paired comparison"
    },
    {
      "id": "D10",
      "label": "Same hospital episode and relevant AR-DRG/year",
      "time_anchor": "hospitalisation_episode",
      "grain": "matched coded hospital episode",
      "inclusion": "paired counterfactual eligible ICU hours and DRG/year",
      "missingness": "unknown coding/annual weight is not an inferred zero"
    },
    {
      "id": "D11",
      "label": "Paid and productive rostered nursing hours",
      "time_anchor": "nursing_shift",
      "grain": "roster interval and FTE",
      "inclusion": "shift hours net of leave/relief, eligible pay classifications",
      "missingness": "no unverified salary or penalty inference"
    },
    {
      "id": "D12",
      "label": "All relevant patient journey stages with defined chronology",
      "time_anchor": "transfer_stage",
      "grain": "one disjoint event interval",
      "inclusion": "readiness/referral/bed/transport/departure stages",
      "missingness": "unknown stages cannot be zero-duration"
    },
    {
      "id": "D13",
      "label": "Endpoint-specific completed patient follow-up",
      "time_anchor": "endpoint_index",
      "grain": "eligible patients with complete endpoint ascertainment",
      "inclusion": "index discharges with endpoint-specific follow-up and censoring",
      "missingness": "competing events and unknown follow-up reported separately"
    }
  ],
