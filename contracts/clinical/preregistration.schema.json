{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:icu-liaison:preregistration:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "status",
    "protocol_id",
    "data_class",
    "target_population",
    "comparators",
    "exposure_definition",
    "outcomes",
    "causal_design",
    "data_access_authorisation",
    "pre_registration_timestamp",
    "frozen_plan_sha256",
    "independent_statistical_review",
    "clinical_governance_review",
    "finance_review",
    "first_nations_review_where_applicable",
    "observed_clinical_effect",
    "causal_claim_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "const": "2026-11-20-P10-prereg-v2"
    },
    "status": {
      "const": "draft_not_registered_or_approved"
    },
    "protocol_id": {
      "const": "chhhs-icu-liaison-inpatient-evaluation-draft-v1"
    },
    "data_class": {
      "const": "definition_only_no_local_records"
    },
    "target_population": {
      "const": {
        "denominator_id": "D03",
        "minimum_age_years_draft": 16,
        "age_threshold_approved": false
      }
    },
    "comparators": {
      "const": {
        "observed_current_care": "existing_ICU_discharge_coordination_MET_and_ward_escalation_to_be_mapped",
        "proposed_service": "incremental_nurse_led_discharge_coordination_and_ward_followup",
        "existing_service_coverage_verified": false
      }
    },
    "exposure_definition": {
      "const": {
        "primary": "intention_to_cover_by_rostered_ward_shift_eligibility",
        "secondary": "actual_liaison_contact_association_subject_to_indication_bias",
        "implementation_start": null,
        "existing_rostered_hours": null,
        "incremental_rostered_hours": null,
        "actual_contact_events": null,
        "contact_time_before_or_after_icu_discharge": null,
        "implementation_fidelity_status": "not_measured"
      }
    },
    "outcomes": {
      "const": {
        "primary_index_ready_delay_metric_id": "M31",
        "descriptive_all_live_ready_delay_metric_id": "M05",
        "descriptive_all_live_exit_block_metric_id": "M06",
        "unplanned_index_return_metric_id": "M08",
        "return_followup_hours": 72,
        "mandatory_safety_endpoints": [
          "delayed_escalation",
          "post_icu_death",
          "return_severity_and_appropriateness",
          "treatment_limitations",
          "ward_cardiac_arrest",
          "ward_workload"
        ],
        "index_ready_delay_denominator_id": "D14",
        "index_ready_delay_crosswalk": {
          "eligibility": [
            "hospitalisation_pseudonym",
            "index_icu_episode_id",
            "adult_age_at_icu_admission_years",
            "destination_category",
            "icu_admission_at"
          ],
          "timing": [
            "icu_medically_ready_at",
            "icu_actual_departure_at"
          ],
          "field_source": "model-inputs/p2-chhhs-field-crosswalk.json"
        }
      }
    },
    "causal_design": {
      "const": {
        "preferred": "controlled_interrupted_time_series_or_phased_rollout",
        "actual_control_wards": null,
        "rollout_date": null,
        "pre_specified_covariates": [
          "age",
          "admission_diagnosis",
          "severity",
          "ventilation",
          "surgical_elective_status",
          "ward",
          "weekday_shift",
          "staffed_icu_occupancy",
          "transport_constraints",
          "treatment_limitations"
        ],
        "negative_controls": [
          "pre_intervention_leads",
          "no_liaison_coverage_shifts",
          "unaffected_outcomes_where_clinically_defensible"
        ],
        "clustering": "unit_and_calendar_week",
        "post_treatment_contact_not_baseline_confounder": true
      }
    },
    "data_access_authorisation": {
      "type": "null"
    },
    "pre_registration_timestamp": {
      "type": "null"
    },
    "frozen_plan_sha256": {
      "type": "null"
    },
    "independent_statistical_review": {
      "type": "null"
    },
    "clinical_governance_review": {
      "type": "null"
    },
    "finance_review": {
      "type": "null"
    },
    "first_nations_review_where_applicable": {
      "type": "null"
    },
    "observed_clinical_effect": {
      "type": "null"
    },
    "causal_claim_status": {
      "const": "not_estimable_without_governed_data"
    }
  }
}
