{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>edithatogo/renovate-config#19c8297137dd58de7dbc83ba9de187bf7dc67e5f"],
  "automerge": false,
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Require reviewed dependency and provider promotions",
      "matchUpdateTypes": [
        "major", "minor", "patch", "pin", "pinDigest", "digest",
        "lockFileMaintenance", "lockfileUpdate", "rollback", "bump", "replacement"
      ],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "Review compatible Python lock maintenance together",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-ci.txt",
        "requirements-p11.txt",
        "requirements-quality.txt"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "certifi",
        "charset-normalizer",
        "filelock",
        "platformdirs",
        "pydantic",
        "pydantic-core",
        "pyyaml",
        "virtualenv"
      ],
      "groupName": "ICU Python lock maintenance"
    },
    {
      "description": "Review both Kairos crate revisions in the same change",
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "native/kairos-icu-liaison/Cargo.toml"
      ],
      "matchDepNames": [
        "kairo-ecs-des",
        "kairo-ecs-types"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "ICU Kairos native crate pins"
    }
  ]
}
