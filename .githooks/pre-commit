#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
PY="$ROOT/.venv/bin/python"

if [[ ! -x "$PY" ]]; then
  echo "ERROR: $PY not found or not executable." >&2
  echo "Create the isolated Python 3.13 environment before committing:" >&2
  echo "  uv venv --python 3.13 .venv && uv pip install --python .venv/bin/python -c requirements-ci.txt '.[test,report]'" >&2
  exit 1
fi

exec "$PY" "$ROOT/tools/run_local_ci.py" --mode pre-commit --check-staged --gitleaks
