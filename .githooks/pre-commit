#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
PY="$ROOT/.venv/bin/python"

if [[ ! -x "$PY" ]]; then
  echo "ERROR: $PY not found or not executable." >&2
  echo "Set up the repository .venv from .python-version using README.md." >&2
  exit 1
fi

exec "$PY" "$ROOT/tools/run_local_ci.py" --mode pre-commit --check-staged --gitleaks
