{
  "schema_version": 1,
  "protocol_id": "chhhs-icu-liaison-inpatient-evaluation-draft-v1",
  "status": "draft_unapproved",
  "setting": "Cairns Hospital adult ICU and receiving CHHHS wards; exact service catchment to verify before site-specific evaluation",
  "decision_maker": "Cairns_and_Hinterland_HHS",
  "target_decision": "incremental_icu_liaison_service_investment",
  "eligibility": {
    "target_site": "Cairns Hospital adult ICU, actual service geography to be approved",
    "minimum_age_years": 16,
    "analysis_unit": "first_eligible_live_ward_discharge_per_hospitalisation",
    "eligible_destinations": [
      "ward_same_hospital",
      "ward_same_hhs"
    ],
    "excluded_dispositions": [
      "icu_death",
      "icu_to_icu_transfer",
      "direct_home",
      "interhospital_transfer_without_followup"
    ],
    "repeat_episode_handling": "first_index_discharge_for_primary_analysis_all_episodes_for_costing",
    "hospitalisation_linkage": "pseudonymous_hospitalisation_identifier_required"
  },
  "strategies": [
    {
      "id": "current_care",
      "role": "observed_comparator",
      "evidence_status": "not_verified",
      "activities": [
        "Existing ICU discharge coordination, ward escalation and MET pathways must be mapped rather than assumed absent"
      ],
      "funded_fte": null,
      "hours_of_coverage_per_week": null,
      "current_work_absorbed_or_displaced": "Not yet measured; obtain rosters and actual activity.",
      "site_source_reference": null
    },
    {
      "id": "liaison_service",
      "role": "proposed_incremental",
      "evidence_status": "not_verified",
      "activities": [
        "Discharge readiness and handover support",
        "Time-limited post-discharge review",
        "Ward clinical escalation support",
        "Staff education and transition support"
      ],
      "funded_fte": null,
      "hours_of_coverage_per_week": null,
      "current_work_absorbed_or_displaced": "Incremental over existing practice; advanced NP/MET variant requires a separate comparator.",
      "site_source_reference": null
    }
  ],
  "endpoints": {
    "ready_to_physical_departure_hours": {
      "id": "ready_to_physical_departure_hours",
      "role": "primary_operational",
      "denominator": "eligible_index_live_ward_discharges",
      "start_event": "clinical_discharge_readiness",
      "end_event": "physical_icu_departure",
      "unit": "hours",
      "window_hours": null,
      "threshold_hours": null,
      "missing_data_policy": "retain_unknown_and_report_completeness",
      "interpretation": "Individual elapsed readiness-to-physical-departure hours; not whole ICU length of stay or automatically avoidable."
    },
    "exit_block_ge12h": {
      "id": "exit_block_ge12h",
      "role": "secondary_operational",
      "denominator": "eligible_index_live_ward_discharges",
      "start_event": "clinical_discharge_readiness",
      "end_event": "physical_icu_departure",
      "unit": "proportion",
      "threshold_hours": 12,
      "window_hours": null,
      "missing_data_policy": "retain_unknown_and_report_completeness",
      "interpretation": "Within the local index-live-ward cohort, >=12 h. Compare to CCR >=12 h only with explicit denominator differences (CCR all live ward/home)."
    },
    "unplanned_72h_return": {
      "id": "unplanned_72h_return",
      "role": "primary_operational",
      "denominator": "eligible_index_live_ward_discharges",
      "start_event": "physical_icu_departure",
      "end_event": "any_unplanned_icu_return_same_hospital_stay",
      "unit": "proportion",
      "window_hours": 72,
      "threshold_hours": null,
      "missing_data_policy": "retain_unknown_and_report_completeness",
      "interpretation": "ANY unplanned ICU return <72 h after actual departure, per index live ward discharge. Not the APD patient rate or CCR all-admission episode rate."
    },
    "after_hours_icu_discharge": {
      "id": "after_hours_icu_discharge",
      "role": "secondary_operational",
      "denominator": "eligible_index_live_ward_discharges",
      "start_event": "physical_icu_departure",
      "end_event": "local_time_1800_through_0559",
      "unit": "proportion",
      "window_hours": null,
      "threshold_hours": null,
      "missing_data_policy": "retain_unknown_and_report_completeness",
      "interpretation": "Physical ICU departure at 18:00:00-05:59:59 local Brisbane time; denominator differs from CCR ward/home."
    },
    "post_icu_death": {
      "id": "post_icu_death",
      "role": "safety",
      "denominator": "eligible_index_live_ward_discharges",
      "start_event": "physical_icu_departure",
      "end_event": "death_before_final_hospital_discharge",
      "unit": "proportion",
      "window_hours": null,
      "threshold_hours": null,
      "missing_data_policy": "retain_unknown_and_report_completeness",
      "interpretation": "Hospital mortality after live index ICU discharge; deaths before adequate surveillance are competing events."
    },
    "ward_cardiac_arrest": {
      "id": "ward_cardiac_arrest",
      "role": "safety",
      "denominator": "eligible_index_live_ward_discharges",
      "start_event": "physical_icu_departure",
      "end_event": "ward_cardiac_arrest_before_final_hospital_discharge",
      "unit": "proportion",
      "window_hours": null,
      "threshold_hours": null,
      "missing_data_policy": "retain_unknown_and_report_completeness",
      "interpretation": "Ward arrests after ICU departure; adjudicate resuscitation eligibility and goals of care."
    },
    "delayed_escalation": {
      "id": "delayed_escalation",
      "role": "safety",
      "denominator": "eligible_index_live_ward_discharges",
      "start_event": "ward_deterioration_recognised",
      "end_event": "appropriate_escalation",
      "unit": "hours",
      "window_hours": null,
      "threshold_hours": null,
      "missing_data_policy": "retain_unknown_and_report_completeness",
      "interpretation": "Time from documented ward deterioration/recognition to appropriate escalation; avoid excluding unrecognised deterioration."
    },
    "return_severity_and_appropriateness": {
      "id": "return_severity_and_appropriateness",
      "role": "safety",
      "denominator": "observed_icu_returns_after_index",
      "start_event": "icu_return",
      "end_event": "documented_rescue_and_severity_review",
      "unit": "clinical_review",
      "window_hours": null,
      "threshold_hours": null,
      "missing_data_policy": "retain_unknown_and_report_completeness",
      "interpretation": "Independent review of severity at return, rescue appropriateness and treatment limitations; higher readmission alone does not imply harm."
    },
    "ward_workload": {
      "id": "ward_workload",
      "role": "safety",
      "denominator": "eligible_index_live_ward_discharges",
      "start_event": "physical_icu_departure",
      "end_event": "ward_care_until_hospital_discharge",
      "unit": "staff_time",
      "window_hours": null,
      "threshold_hours": null,
      "missing_data_policy": "retain_unknown_and_report_completeness",
      "interpretation": "Measure nursing/medical workload displaced from ICU to receiving ward, with appropriate perspective and coverage."
    },
    "treatment_limitations": {
      "id": "treatment_limitations",
      "role": "safety",
      "denominator": "eligible_index_live_ward_discharges",
      "start_event": "physical_icu_departure",
      "end_event": "treatment_goals_reconciled",
      "unit": "clinical_review",
      "window_hours": null,
      "threshold_hours": null,
      "missing_data_policy": "retain_unknown_and_report_completeness",
      "interpretation": "Explicit treatment goals, escalation plans and documentation on transfer; do not interpret planned no-reintubation as missed rescue."
    }
  },
  "safety": {
    "required_endpoints": [
      "delayed_escalation",
      "post_icu_death",
      "return_severity_and_appropriateness",
      "treatment_limitations",
      "ward_cardiac_arrest",
      "ward_workload"
    ],
    "approved_noninferiority_margins": {},
    "measurements_status": "unmeasured",
    "decision_gate": "safety_review_required_prior_to_investment_claim"
  },
