{
  "$defs": {
    "AdmissionRequest": {
      "additionalProperties": false,
      "properties": {
        "admitted_minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Admitted Minute"
        },
        "disposition": {
          "enum": [
            "admitted",
            "declined",
            "censored"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "request_id": {
          "pattern": "^syn-[a-z0-9_-]{1,80}$",
          "title": "Request Id",
          "type": "string"
        },
        "request_minute": {
          "minimum": 0,
          "title": "Request Minute",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "request_minute",
        "disposition",
        "admitted_minute"
      ],
      "title": "AdmissionRequest",
      "type": "object"
    },
    "ArmTrace": {
      "additionalProperties": false,
      "properties": {
        "occupancies": {
          "items": {
            "$ref": "#/$defs/Occupancy"
          },
          "maxItems": 100000,
          "title": "Occupancies",
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/AdmissionRequest"
          },
          "maxItems": 100000,
          "title": "Requests",
          "type": "array"
        },
        "strategy_id": {
          "pattern": "^[a-z][a-z0-9_]{1,48}$",
          "title": "Strategy Id",
          "type": "string"
        }
      },
      "required": [
        "strategy_id",
        "occupancies",
        "requests"
      ],
      "title": "ArmTrace",
      "type": "object"
    },
    "CapacityWindow": {
      "additionalProperties": false,
      "properties": {
        "end_minute": {
          "exclusiveMinimum": 0,
          "title": "End Minute",
          "type": "integer"
        },
        "staffed_beds": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Staffed Beds",
          "type": "integer"
        },
        "start_minute": {
          "minimum": 0,
          "title": "Start Minute",
          "type": "integer"
        }
      },
      "required": [
        "start_minute",
        "end_minute",
        "staffed_beds"
      ],
      "title": "CapacityWindow",
      "type": "object"
    },
    "Occupancy": {
      "additionalProperties": false,
      "properties": {
        "end_minute": {
          "exclusiveMinimum": 0,
          "title": "End Minute",
          "type": "integer"
        },
        "episode_id": {
          "pattern": "^syn-[a-z0-9_-]{1,80}$",
          "title": "Episode Id",
          "type": "string"
        },
        "start_minute": {
          "minimum": 0,
          "title": "Start Minute",
          "type": "integer"
        }
      },
      "required": [
        "episode_id",
        "start_minute",
        "end_minute"
      ],
      "title": "Occupancy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capacity": {
      "items": {
        "$ref": "#/$defs/CapacityWindow"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Capacity",
      "type": "array"
    },
    "data_class": {
      "const": "synthetic",
      "title": "Data Class",
      "type": "string"
    },
    "horizon_minutes": {
      "maximum": 525600,
      "minimum": 1,
      "title": "Horizon Minutes",
      "type": "integer"
    },
    "notes": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Notes",
      "type": "string"
    },
    "qualification": {
      "const": "source_fixture_only_not_native_DES",
      "title": "Qualification",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_engine": {
      "const": "not_kairos",
      "title": "Source Engine",
      "type": "string"
    },
    "strategies": {
      "items": {
        "$ref": "#/$defs/ArmTrace"
      },
      "maxItems": 8,
      "minItems": 2,
      "title": "Strategies",
      "type": "array"
    },
    "trace_source": {
      "const": "synthetic_fixture",
      "title": "Trace Source",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "data_class",
    "source_engine",
    "trace_source",
    "scenario_id",
    "horizon_minutes",
    "capacity",
    "strategies",
    "qualification",
    "notes"
  ],
  "title": "TraceBundle",
  "type": "object"
}
